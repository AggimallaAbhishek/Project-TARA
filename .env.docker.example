# Docker Compose overrides layered on top of backend/.env.
# Copy to .env.docker and fill in real values. NEVER commit .env.docker.

# Google OAuth client id (public identifier, safe to expose to the browser).
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# JWT signing key. Must be >= 32 bytes for HS256 (RFC 7518 3.2) and the app
# refuses to boot in production with the placeholder. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-secret

# Comma-separated CORS allowlist for the browser origin(s) serving the frontend.
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1
